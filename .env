# Configuration BSTO - Briançon Sustainable Tourism Observatory
# Variables d'environnement pour MinIO et autres services

# ==========================================
# MinIO (remplace Google Cloud Storage)
# ==========================================
MINIO_ENDPOINT=localhost:9000
MINIO_USER=admin
MINIO_PASSWORD=briancon2026
BUCKET_BRONZE=briancon-bronze
BUCKET_SILVER=briancon-silver
BUCKET_GOLD=briancon-gold

# ==========================================
# API Open-Meteo
# ==========================================
OPEN_METEO_LATITUDE=44.89
OPEN_METEO_LONGITUDE=6.64

# ==========================================
# Chemins locaux
# ==========================================
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
DUCKDB_PATH=./data/duckdb/briancon.duckdb